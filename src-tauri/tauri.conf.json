{
  "package": {
    "productName": "Clash Astra",
    "version": "1.8.1"
  },
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:3000/",
    "beforeDevCommand": "node scripts/build/build-watchdog.mjs --debug && pnpm run web:dev",
    "beforeBuildCommand": "pnpm run web:build"
  },
  "tauri": {
    "bundle": {
      "active": false,
      "identifier": "io.github.clash-astra",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "resources": ["resources"],
      "externalBin": ["sidecar/mihomo", "sidecar/mihomo-alpha"],
      "copyright": "© 2026 Clash Astra",
      "category": "DeveloperTool",
      "shortDescription": "Clash Astra",
      "longDescription": "Clash Astra"
    },

    "updater": {
      "active": false
    },

    "allowlist": {
      "shell": {
        "all": true
      },
      "window": {
        "all": true
      },
      "process": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "dialog": {
        "all": false,
        "open": true
      },
      "protocol": {
        "asset": true,
        "assetScope": ["$RESOURCE/**"]
      },
      "path": {
        "all": true
      }
    },
    "windows": [],
    "security": {
      "csp": "script-src 'self'; default-src blob: data: filesystem: ws: wss: http: https: tauri: 'unsafe-inline' 'self'; img-src asset: http: https: data: 'self';"
    }
  }
}
